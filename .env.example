# Ledgerflow local environment template.
#
# Copy to .env (`make install` does this in slice 3). .env is never tracked;
# this file is, and it documents the runtime contract the compose stack
# expects. It contains no secrets: the credentials below are local-only
# defaults for a loopback-bound database.

# --- Docker Compose ---------------------------------------------------------
# Scopes containers, networks and volumes. Give a second checkout of this
# repository a different value so its stack cannot collide with, or tear down,
# this one.
COMPOSE_PROJECT_NAME=ledgerflow

# Host interface and port for the web tier. Loopback by default: the API has no
# authentication yet and should not be reachable from the local network by
# accident. Compose derives the container's APP_URL from these two values.
APP_BIND=127.0.0.1
APP_PORT=8080

# --- Application ------------------------------------------------------------
APP_NAME=Ledgerflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Compose overrides this for the container using APP_BIND and APP_PORT. The
# value here serves host-side tooling that reads .env directly.
APP_URL=http://127.0.0.1:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL -------------------------------------------------------------
# One pinned engine hosts two databases: ledgerflow for development and
# ledgerflow_test for the suite. SQLite is not a supported target; PostgreSQL
# concurrency and advisory-lock behaviour are load-bearing for Payments.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ledgerflow
DB_USERNAME=ledgerflow
DB_PASSWORD=ledgerflow

# --- Redis ------------------------------------------------------------------
# Cache, session and queue transport. Never the sole recovery source for
# financial state; PostgreSQL holds business and delivery truth.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# --- Payments outbox relay --------------------------------------------------
# Operational defaults, not domain rules: the compatibility and load-test
# milestone may tune them without weakening acceptance tests.
#
# WHAT IS DELIBERATELY ABSENT. The queue connection name, the queue name, the
# heartbeat cache store, the heartbeat TTL and `after_commit => false` are
# LITERALS in config/payments.php and config/queue.php. Changing them from .env
# would let this file and the Horizon supervision T8 adds disagree about where
# messages go, with nothing failing. See those files for the reasoning.
#
# RelayConfiguration validates every value below at container resolution, so an
# empty or non-numeric entry fails loudly rather than becoming a zero-valued
# limit at run time.

# Logical Redis database for the relay queue and its heartbeat store. Separate
# from the cache (1) and the default (0) so a queue key and a cache key can
# never collide.
REDIS_PAYMENTS_DB=2

# Publication happens INSIDE an open PostgreSQL transaction holding a row lock,
# so these are database-occupancy bounds, not transport niceties.
PAYMENTS_RELAY_REDIS_TIMEOUT=0.25
PAYMENTS_RELAY_REDIS_READ_TIMEOUT=0.25

# Rows per invocation, and the budget checked BEFORE each next row transaction.
# A row already begun always finishes; the budget only stops the next one.
PAYMENTS_RELAY_BATCH_SIZE=50
PAYMENTS_RELAY_START_BUDGET_MS=750
PAYMENTS_RELAY_STATEMENT_TIMEOUT_MS=500

# How long an accepted row waits before it becomes eligible again. Never zero:
# with no consumer to complete it, a zero grace republishes every accepted row
# on the very next pass.
PAYMENTS_RELAY_GRACE_SECONDS=30

# Transport backoff: 1, 2, 4 ... capped. An arbitrarily long outage produces an
# arbitrarily large failure count and never exhausts a row.
PAYMENTS_RELAY_BACKOFF_BASE_SECONDS=1
PAYMENTS_RELAY_BACKOFF_MAX_SECONDS=300

# Three missed one-second ticks before the scheduler heartbeat reads stale.
PAYMENTS_RELAY_HEARTBEAT_FRESHNESS_SECONDS=3

# Redis queue visibility window for a message no worker has completed. Inert
# until T8 runs a worker.
PAYMENTS_RELAY_QUEUE_RETRY_AFTER=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@ledgerflow.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend ---------------------------------------------------------------
# This repository builds no frontend assets; the merchant dashboard lives in
# ledgerflow-spa. The Vite scaffolding that ships with the Laravel skeleton is
# inert and retained only to keep the skeleton diff clean.
VITE_APP_NAME="${APP_NAME}"
