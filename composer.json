{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mythern/ledgerflow-api",
    "type": "project",
    "description": "Ledgerflow API — a DDD/CQRS/event-sourcing fintech reference application: Laravel domain modules, an internal Filament panel, and the application runtime contracts.",
    "keywords": [
        "ddd",
        "cqrs",
        "event-sourcing",
        "fintech",
        "laravel",
        "payments"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "laravel/framework": "^13.8",
        "laravel/horizon": "^5.48",
        "laravel/sanctum": "^4",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13",
        "spatie/laravel-event-sourcing": "^7.15"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.1"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
