includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # No baseline: lower the level explicitly rather than absorbing findings into suppressions.
    level: 10

    paths:
        - app
        - Modules
        - bootstrap/app.php
        - config
        - database
        - routes
        # Only the pre-autoload guard is analysed from tests/: PHPStan cannot see through Pest's fluent DSL.
        - tests/bootstrap.php

    excludePaths:
        - bootstrap/cache
        - storage
        - vendor
        # The trailing /* is required: PHPStan fnmatches file paths, so Modules/*/tests alone excludes nothing.
        - Modules/*/tests/*
