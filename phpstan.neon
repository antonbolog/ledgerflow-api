includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # No baseline: lower the level explicitly rather than absorbing findings into suppressions.
    level: 10

    paths:
        - app
        - Modules
        - bootstrap/app.php
        - config
        - database
        - routes
        # Only the pre-autoload guard is analysed from tests/: PHPStan cannot see through Pest's fluent DSL.
        - tests/bootstrap.php

    excludePaths:
        - bootstrap/cache
        - storage
        - vendor
        # The trailing /* is required: PHPStan fnmatches file paths, so Modules/*/tests alone excludes nothing.
        - Modules/*/tests/*
        # Published unchanged by vendor:publish --tag=passport-migrations; generated files are not hand-edited.
        - database/migrations/2026_09_17_165725_create_oauth_auth_codes_table.php
        - database/migrations/2026_09_17_165726_create_oauth_access_tokens_table.php
        - database/migrations/2026_09_17_165727_create_oauth_refresh_tokens_table.php
        - database/migrations/2026_09_17_165728_create_oauth_clients_table.php
        - database/migrations/2026_09_17_165729_create_oauth_device_codes_table.php
