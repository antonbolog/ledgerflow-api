# Operating systems
.DS_Store
Thumbs.db

# IDEs and editors
.idea/
.vscode/
.cursor/
.codex/
.fleet/
.history/
/.nova
/.zed
.phpactor.json
*.code-workspace

# Local AI delivery artifacts
/.ai/

# Claude Code: the shared project configuration in /.claude/ is tracked on purpose.
# Only the per-machine permission cache is local. Declared here rather than relying
# on the user-global ignore file, so the exclusion travels with the repository.
/.claude/settings.local.json

# Environment and credentials
.env
.env.*
!.env.example
auth.json

# Dependencies
/vendor/
/node_modules/

# Generated application artifacts
# Laravel's own nested .gitignore files under storage/ and bootstrap/cache/
# stay tracked; nothing here may shadow them.
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json
/storage/*.key
/.phpunit.cache/
.phpunit.result.cache

# Logs
*.log
npm-debug.log
yarn-error.log

# Temporary scaffolding scratch space (T1 bootstrap only, never committed)
/.bootstrap/

# Graphify
# Exclude local Graphify cache, usage data, machine-specific paths, dated
# pre-update backups, integrity signatures, and the incremental-build manifest.
# `manifest.json` is local rebuild state — it records per-file hashes and mtimes
# of one machine's last build, so it conflicts on every merge and proves nothing
# about the graph. The curated root artifacts (graph.json, graph.html,
# GRAPH_REPORT.md, .graphify_labels.json) stay tracked for repository use.
graphify-out/cache/
graphify-out/cost.json
graphify-out/manifest.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/*.sig
